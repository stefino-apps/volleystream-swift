platform :ios, '14.0'
use_frameworks!

target 'VolleyStreamPro' do
  # Motore RTMP e Fotocamera
  pod 'HaishinKit', '~> 1.7.0'

  # Firebase SDK per Sincronizzazione Punteggio (Telecomando)
  pod 'Firebase/Core'
  pod 'Firebase/Database'
  pod 'Firebase/Auth'

  # Autenticazione Google/YouTube
  pod 'GoogleSignIn'
  pod 'AppAuth'

  # Google API Client for REST (YouTube Data API v3)
  pod 'GoogleAPIClientForREST/YouTube'
end
